# Copy to .env for local development. Never commit real values.

# Postgres connection string. On Netlify, Netlify DB injects NETLIFY_DATABASE_URL
# automatically. Leave both unset locally to use an embedded database in .data/pglite.
# NETLIFY_DATABASE_URL=postgres://user:password@host/db?sslmode=require
# DATABASE_URL=

# Secret used to sign CSRF tokens and hash client IPs for rate limiting.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Public origin of the site (canonical URLs, sitemap, Open Graph).
SITE_URL=http://localhost:4321

# Where uploaded media is stored: "netlify-blobs" (production default) or "local"
# (development default, files go to .data/media).
# MEDIA_STORAGE=local
