---
import Article from '../../components/blog/Article.astro';
import PostCard from '../../components/blog/PostCard.astro';
import ShareBar from '../../components/blog/ShareBar.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { initials } from '../../lib/format.ts';
import { getServices } from '../../server/container.ts';

const slug = Astro.params.slug ?? '';
let services;
try {
  services = await getServices();
} catch (err) {
  console.error('[blogs] article failed', err);
  return new Response('The blog is temporarily unavailable.', { status: 503 });
}
const { posts, settings } = services;
const found = await posts.readBySlug(slug);
if (!found) return Astro.rewrite('/404');
if ('redirectTo' in found) return Astro.redirect(`/blogs/${found.redirectTo}`, 301);

const { article } = found;
const [related, adjacent, author] = await Promise.all([posts.related(article.id), posts.adjacent(article.id), settings.author()]);
const url = new URL(`/blogs/${article.slug}`, Astro.site).href;
const title = article.seoTitle || article.title;
const description = (article.seoDescription || article.excerpt).slice(0, 300);
const shareImage = article.ogImage ?? article.coverImage;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    headline: article.title.slice(0, 110),
    description,
    image: shareImage ? [new URL(shareImage.url, Astro.site).href] : undefined,
    datePublished: article.publishedAt,
    dateModified: article.updatedAt,
    wordCount: article.wordCount,
    articleSection: article.categories[0]?.name,
    keywords: article.tags.map((t) => t.name).join(', ') || undefined,
    author: { '@type': 'Person', name: article.authorName, url: new URL('/', Astro.site).href },
    publisher: { '@type': 'Person', name: 'Cynthia J Singh', url: new URL('/', Astro.site).href },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blogs', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: article.title, item: url },
    ],
  },
];
Astro.response.headers.set('Cache-Control', 'public, max-age=0, must-revalidate');
---
<SiteLayout
  title={title}
  description={description}
  canonicalPath={`/blogs/${article.slug}`}
  image={shareImage?.url}
  imageAlt={shareImage?.alt}
  type="article"
  jsonLd={jsonLd}
  article={{
    publishedTime: article.publishedAt,
    modifiedTime: article.updatedAt,
    author: article.authorName,
    tags: article.tags.map((t) => t.name),
    section: article.categories[0]?.name,
  }}
>
  <Article article={article}>
    <footer class="article-foot">
      {article.tags.length > 0 && (
        <ul class="tag-list" aria-label="Tags">
          {article.tags.map((t) => <li><a class="chip" href={`/blogs?tag=${t.slug}`}>#{t.name}</a></li>)}
        </ul>
      )}
      <ShareBar url={url} title={article.title} />
      <section class="author-box" aria-labelledby="about-author">
        <span class="avatar" aria-hidden="true">{initials(author.name)}</span>
        <div>
          <h2 id="about-author">About {author.name}</h2>
          <p>{author.bio}</p>
        </div>
      </section>
      {(adjacent.previous || adjacent.next) && (
        <nav class="prev-next" aria-label="More articles">
          {adjacent.previous && (
            <a href={`/blogs/${adjacent.previous.slug}`} rel="prev">
              <span class="dir">← Previous</span><span class="t">{adjacent.previous.title}</span>
            </a>
          )}
          {adjacent.next && (
            <a class="next" href={`/blogs/${adjacent.next.slug}`} rel="next">
              <span class="dir">Next →</span><span class="t">{adjacent.next.title}</span>
            </a>
          )}
        </nav>
      )}
    </footer>
  </Article>
  {related.length > 0 && (
    <section class="related" aria-labelledby="related-title">
      <div class="container">
        <h2 class="section-title" id="related-title">Related articles</h2>
        <ul class="post-grid">
          {related.map((post) => <li><PostCard post={post} headingLevel="h3" /></li>)}
        </ul>
      </div>
    </section>
  )}
</SiteLayout>
